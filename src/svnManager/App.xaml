<Application x:Class="svnManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:svnManager.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>

        <!-- ── Converters ── -->
        <conv:StatusToColorConverter      x:Key="StatusToColorConverter"/>
        <conv:BoolToVisibilityConverter   x:Key="BoolToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter   x:Key="BoolToHiddenConverter"     Invert="True"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToHiddenConverter"   Invert="True"/>
        <conv:NullToVisibilityConverter   x:Key="NullToVisibilityConverter"/>
        <conv:NullToVisibilityConverter   x:Key="NullToHiddenConverter"     Invert="True"/>
        <conv:StringToInitialConverter    x:Key="StringToInitialConverter"/>
        <conv:AuthorToColorConverter      x:Key="AuthorToColorConverter"/>
        <conv:DiffLineBgConverter         x:Key="DiffLineBgConverter"/>
        <conv:DiffLineFgConverter         x:Key="DiffLineFgConverter"/>

        <!-- ── GitHub Desktop Dark Color Tokens ── -->
        <SolidColorBrush x:Key="BgDarkBrush"      Color="#1C2128"/>
        <SolidColorBrush x:Key="BgPanelBrush"     Color="#22272E"/>
        <SolidColorBrush x:Key="BgItemBrush"      Color="#2D333B"/>
        <SolidColorBrush x:Key="BgHoverBrush"     Color="#2B3140"/>
        <SolidColorBrush x:Key="BgSelectedBrush"  Color="#1E3A5F"/>
        <SolidColorBrush x:Key="BorderBrush"      Color="#373E47"/>
        <SolidColorBrush x:Key="AccentBlueBrush"  Color="#58A6FF"/>
        <SolidColorBrush x:Key="BtnBlueBrush"     Color="#1F6FEB"/>
        <SolidColorBrush x:Key="BtnCommitBrush"   Color="#238636"/>
        <SolidColorBrush x:Key="FgPrimaryBrush"   Color="#CDD9E5"/>
        <SolidColorBrush x:Key="FgSecondaryBrush" Color="#768390"/>
        <SolidColorBrush x:Key="FgMutedBrush"     Color="#545D68"/>
        <SolidColorBrush x:Key="ErrorBrush"       Color="#F85149"/>
        <SolidColorBrush x:Key="SuccessBrush"     Color="#3FB950"/>
        <SolidColorBrush x:Key="DiffAddBgBrush"   Color="#1A3B1D"/>
        <SolidColorBrush x:Key="DiffDelBgBrush"   Color="#3B1A1A"/>
        <SolidColorBrush x:Key="DiffAddNumBgBrush" Color="#1D3D20"/>
        <SolidColorBrush x:Key="DiffDelNumBgBrush" Color="#3D1E1E"/>
        <SolidColorBrush x:Key="DiffHunkBgBrush"  Color="#1A2233"/>

        <!-- ── Base TextBlock ── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- ── TextBox ── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="{StaticResource BgItemBrush}"/>
            <Setter Property="Foreground"   Value="{StaticResource FgPrimaryBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="8,5"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CaretBrush"   Value="{StaticResource FgPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Button ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"    Value="{StaticResource BtnBlueBrush}"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"       Value="16,7"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A60D0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1550B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgItemBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Commit Button (green, full width) ── -->
        <Style x:Key="CommitButton" TargetType="Button">
            <Setter Property="Background"    Value="{StaticResource BtnCommitBrush}"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"       Value="8,8"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EA043"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E8030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgItemBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost Button ── -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="{StaticResource FgPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"   Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding"       Value="10,5"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgItemBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Icon Button (no border) ── -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="{StaticResource FgSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"       Value="6"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgItemBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource FgPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CheckBox ── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource FgPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Background="Transparent">
                                <Path x:Name="Check" Data="M2,7 L6,11 L12,3"
                                      Stroke="{StaticResource AccentBlueBrush}" StrokeThickness="1.8"
                                      Visibility="Collapsed" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"   Property="Background"   Value="{StaticResource AccentBlueBrush}"/>
                                <Setter TargetName="Box"   Property="BorderBrush"  Value="{StaticResource AccentBlueBrush}"/>
                                <Setter TargetName="Check" Property="Visibility"   Value="Visible"/>
                                <Setter TargetName="Check" Property="Stroke"       Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Thin ScrollBar ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="0"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#4D5566" CornerRadius="3" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="6"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── ProgressBar ── -->
        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="Transparent">
                            <Border x:Name="PART_Track" Background="Transparent">
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{StaticResource AccentBlueBrush}"
                                           HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
