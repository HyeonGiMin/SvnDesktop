<Window x:Class="svnManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:svnManager.ViewModels"
        xmlns:models="clr-namespace:svnManager.Models"
        xmlns:views="clr-namespace:svnManager.Views"
        Title="SVN Manager" Height="780" Width="1200"
        MinHeight="500" MinWidth="800"
        Background="{StaticResource BgDarkBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChangesViewModel}">
            <views:ChangesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             TOP TOOLBAR
        ═══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Current repository button -->
                <Button Grid.Column="0"
                        x:Name="RepoDropBtn"
                        Command="{Binding ToggleRepoDropdownCommand}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- folder icon -->
                                    <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{StaticResource FgSecondaryBrush}"
                                                  Data="M10,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8L10,4z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Current repository"
                                                   FontSize="10" Foreground="{StaticResource FgMutedBrush}"
                                                   Margin="0,0,0,1"/>
                                        <TextBlock Text="{Binding SelectedRepository.Name, FallbackValue='저장소 선택'}"
                                                   FontSize="13" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- chevron -->
                                    <Viewbox Grid.Column="2" Width="10" Height="10" Margin="6,0,0,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{StaticResource FgSecondaryBrush}"
                                                  StrokeThickness="2.5" StrokeLineJoin="Round"
                                                  Data="M6,9 L12,15 L18,9"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Vertical divider -->
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

                <!-- CENTER: SVN URL button -->
                <Button Grid.Column="2"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="14,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- SVN branch icon -->
                                    <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{StaticResource FgSecondaryBrush}" StrokeThickness="2"
                                                  Fill="Transparent"
                                                  Data="M6,3A3,3 0 0,1 9,6C9,8.2 7.2,10 5,10.05V14C5,15.1 5.9,16 7,16H9.5C10.33,16 11,16.67 11,17.5V19.5A3,3 0 0,1 8,22.5A3,3 0 0,1 5,19.5V17.5C5,16.67 5.67,16 6.5,16H4C2.9,16 2,15.1 2,14V10.05C.8,9.82 0,8.52 0,7A3,3 0 0,1 3,4A3,3 0 0,1 6,7C6,8.52 5.2,9.82 4,10.05V14H6.5C7.33,14 8,14.67 8,15.5V19.5A1,1 0 0,0 9,20.5A1,1 0 0,0 10,19.5V17.5C10,16.67 9.33,16 8.5,16H7A3,3 0 0,1 4,13V10.05C2.8,9.82 2,8.52 2,7A3,3 0 0,1 5,4A3,3 0 0,1 8,7"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="SVN URL"
                                                   FontSize="10" Foreground="{StaticResource FgMutedBrush}"
                                                   Margin="0,0,0,1"/>
                                        <TextBlock Text="{Binding SvnUrl, FallbackValue='—'}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource FgPrimaryBrush}"/>
                                    </StackPanel>
                                    <!-- chevron -->
                                    <Viewbox Grid.Column="2" Width="10" Height="10" Margin="6,0,0,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{StaticResource FgSecondaryBrush}"
                                                  StrokeThickness="2.5" StrokeLineJoin="Round"
                                                  Data="M6,9 L12,15 L18,9"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Vertical divider -->
                <Border Grid.Column="3" Background="{StaticResource BorderBrush}"/>

                <!-- RIGHT: Update button -->
                <Button Grid.Column="4"
                        Command="{Binding ChangesVM.UpdateCommand}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="0"
                        HorizontalContentAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="16,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- refresh icon -->
                                    <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{StaticResource FgPrimaryBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                                  Data="M4,12 A8,8 0 1,1 12,20 M4,12 L4,7 L9,12"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="업데이트"
                                                   FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ChangesVM.StatusMessage, FallbackValue='마지막 업데이트 ...'}"
                                                   FontSize="10" Foreground="{StaticResource FgMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════
             REPO DROPDOWN POPUP
        ═══════════════════════════════════════ -->
        <Popup Grid.Row="0"
               PlacementTarget="{Binding ElementName=RepoDropBtn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsRepoDropdownOpen, Mode=TwoWay}"
               Width="300">
            <Border Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Filter textbox -->
                    <Border Padding="8,8,8,6">
                        <TextBox Text="{Binding RepoSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="8,5"/>
                    </Border>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,4"/>

                    <TextBlock Text="저장소 목록"
                               FontSize="11" Foreground="{StaticResource FgMutedBrush}"
                               Margin="12,2,12,4" FontWeight="SemiBold"/>

                    <!-- Repo list -->
                    <ListBox ItemsSource="{Binding FilteredRepositories}"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="260"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgItemBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Repository}">
                                <Button Command="{Binding DataContext.SelectRepositoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand" Padding="12,8">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Fill="{StaticResource FgSecondaryBrush}"
                                                                  Data="M10,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8L10,4z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding LocalPath}"
                                                                   FontSize="11" Foreground="{StaticResource FgSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,0"/>

                    <!-- Add repo button -->
                    <Button Command="{Binding AddRepositoryCommand}"
                            Style="{StaticResource IconButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,10" Margin="0,2,0,4"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="16" FontWeight="Light"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="저장소 추가" FontSize="13"
                                       Foreground="{StaticResource FgPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═══════════════════════════════════════
             MAIN CONTENT
        ═══════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <!-- No repo selected — empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding SelectedRepository, Converter={StaticResource NullToHiddenConverter}}">
                <Viewbox Width="56" Height="56" Margin="0,0,0,16" Opacity="0.25">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{StaticResource FgPrimaryBrush}"
                              Data="M10,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8L10,4z"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="저장소를 선택하세요"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource FgSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="상단 드롭다운에서 저장소를 선택하거나 새로 추가하세요"
                           FontSize="12" Foreground="{StaticResource FgMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,20"/>
                <Button Content="저장소 추가"
                        Command="{Binding AddRepositoryCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Repo selected — two-column layout -->
            <Grid Visibility="{Binding SelectedRepository, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="200" MaxWidth="520"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─── LEFT PANEL ─── -->
                <Grid Grid.Column="0" Background="{StaticResource BgPanelBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="160" MinHeight="100"/>
                    </Grid.RowDefinitions>

                    <!-- TAB STRIP -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Changes tab -->
                            <Button Grid.Column="0"
                                    Command="{Binding ShowChangesCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="Bg" Background="Transparent"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="Lbl" Text="Changes"
                                                           FontSize="12"
                                                           Foreground="{StaticResource FgSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <!-- Badge -->
                                                <Border x:Name="Badge"
                                                        Background="{StaticResource BgItemBrush}"
                                                        CornerRadius="8" Padding="4,1" Margin="5,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DataContext.ChangesVM.ChangedFiles.Count, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource FgSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <Border x:Name="ActiveLine" Height="2"
                                                    VerticalAlignment="Bottom"
                                                    Background="{StaticResource AccentBlueBrush}"
                                                    Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsChangesTabActive}" Value="True">
                                                <Setter TargetName="Lbl"        Property="Foreground" Value="{StaticResource FgPrimaryBrush}"/>
                                                <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource FgPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- History tab -->
                            <Button Grid.Column="1"
                                    Command="{Binding ShowHistoryCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="Bg" Background="Transparent"/>
                                            <TextBlock x:Name="Lbl" Text="History"
                                                       FontSize="12"
                                                       Foreground="{StaticResource FgSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border x:Name="ActiveLine" Height="2"
                                                    VerticalAlignment="Bottom"
                                                    Background="{StaticResource AccentBlueBrush}"
                                                    Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHistoryTabActive}" Value="True">
                                                <Setter TargetName="Lbl"        Property="Foreground" Value="{StaticResource FgPrimaryBrush}"/>
                                                <Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource FgPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- FILTER BAR -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgDarkBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Search icon -->
                            <Viewbox Grid.Column="0" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource FgMutedBrush}" StrokeThickness="2.5"
                                          Fill="Transparent"
                                          Data="M10,18A8,8 0 1,1 18,10A8,8 0 0,1 10,18M21,21L15.65,15.65"/>
                                </Canvas>
                            </Viewbox>
                            <!-- Filter textbox (transparent) -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource FgPrimaryBrush}"
                                     FontSize="12" Padding="0,0"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- CONTENT (file list or commit list) -->
                    <ContentPresenter Grid.Row="2" Content="{Binding CurrentView}"/>

                    <!-- SPLITTER between file list and commit panel -->
                    <GridSplitter Grid.Row="3"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}"
                                  ShowsPreview="False"
                                  Visibility="{Binding IsChangesTabActive, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- COMMIT PANEL (Changes tab only) -->
                    <Border Grid.Row="4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8,8,8,10"
                            Visibility="{Binding IsChangesTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Commit message textarea -->
                            <TextBox Grid.Row="0"
                                     Text="{Binding ChangesVM.CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     FontSize="12" Padding="6,5"
                                     VerticalScrollBarVisibility="Auto"/>
                            <!-- Commit button -->
                            <Button Grid.Row="1"
                                    Style="{StaticResource CommitButton}"
                                    Command="{Binding ChangesVM.CommitCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,6,0,0">
                                <TextBlock Text="커밋 변경사항" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- GRIIDSPLITTER -->
                <GridSplitter Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}"
                              ShowsPreview="False"/>

                <!-- ─── RIGHT PANEL ─── -->
                <Grid Grid.Column="2" Background="{StaticResource BgDarkBrush}">

                    <!-- DIFF VIEWER (Changes tab) -->
                    <Grid Visibility="{Binding IsChangesTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- File header bar -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="{StaticResource FgSecondaryBrush}" StrokeThickness="2"
                                              Fill="Transparent"
                                              Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding ChangesVM.SelectedFile.RelativePath, FallbackValue='파일을 선택하면 diff가 표시됩니다'}"
                                           FontSize="12" FontFamily="Consolas"
                                           Foreground="{StaticResource FgSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Empty state (no file selected) -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding ChangesVM.SelectedFile, Converter={StaticResource NullToHiddenConverter}}">
                            <Viewbox Width="40" Height="40" Opacity="0.2" Margin="0,0,0,12">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{StaticResource FgPrimaryBrush}" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                                    <Line X1="8" Y1="13" X2="16" Y2="13" Stroke="{StaticResource FgPrimaryBrush}" StrokeThickness="1.5"/>
                                    <Line X1="8" Y1="17" X2="14" Y2="17" Stroke="{StaticResource FgPrimaryBrush}" StrokeThickness="1.5"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="파일을 선택하세요" FontSize="14"
                                       Foreground="{StaticResource FgSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Diff lines with dual line numbers -->
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{StaticResource BgDarkBrush}"
                                      Visibility="{Binding ChangesVM.SelectedFile, Converter={StaticResource NullToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding ChangesVM.DiffLines}"
                                          Focusable="False"
                                          VirtualizingPanel.IsVirtualizing="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:DiffLine}">
                                        <Border Background="{Binding LineType, Converter={StaticResource DiffLineBgConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Old line number -->
                                                <Border Grid.Column="0"
                                                        Background="{Binding LineType, Converter={StaticResource DiffLineBgConverter}, ConverterParameter=num}">
                                                    <TextBlock Text="{Binding OldLineText}"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{StaticResource FgMutedBrush}"
                                                               TextAlignment="Right"
                                                               Padding="0,1,6,1"/>
                                                </Border>
                                                <!-- New line number -->
                                                <Border Grid.Column="1"
                                                        Background="{Binding LineType, Converter={StaticResource DiffLineBgConverter}, ConverterParameter=num}">
                                                    <TextBlock Text="{Binding NewLineText}"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{StaticResource FgMutedBrush}"
                                                               TextAlignment="Right"
                                                               Padding="0,1,6,1"/>
                                                </Border>
                                                <!-- Content -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Text}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="{Binding LineType, Converter={StaticResource DiffLineFgConverter}}"
                                                           Padding="12,1"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- COMMIT DETAIL (History tab) -->
                    <Grid Visibility="{Binding IsHistoryTabActive, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HistoryVM.SelectedEntry, Converter={StaticResource NullToHiddenConverter}}">
                            <Viewbox Width="40" Height="40" Opacity="0.2" Margin="0,0,0,12">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource FgPrimaryBrush}"
                                          Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="커밋을 선택하세요" FontSize="14"
                                       Foreground="{StaticResource FgSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Commit detail panel -->
                        <Grid Visibility="{Binding HistoryVM.SelectedEntry, Converter={StaticResource NullToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Commit meta header -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource BgPanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Large avatar -->
                                    <Grid Grid.Column="0" Width="42" Height="42" Margin="0,0,14,0">
                                        <Ellipse Width="42" Height="42"
                                                 Fill="{Binding HistoryVM.SelectedEntry.Author, Converter={StaticResource AuthorToColorConverter}}"/>
                                        <TextBlock Text="{Binding HistoryVM.SelectedEntry.Author, Converter={StaticResource StringToInitialConverter}}"
                                                   FontSize="16" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding HistoryVM.SelectedEntry.Message}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding HistoryVM.SelectedEntry.Author}"
                                                       FontSize="12" Foreground="{StaticResource FgSecondaryBrush}"/>
                                            <TextBlock Text=" · " FontSize="12" Foreground="{StaticResource FgMutedBrush}"/>
                                            <TextBlock Text="{Binding HistoryVM.SelectedEntry.Date, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                       FontSize="12" Foreground="{StaticResource FgSecondaryBrush}"/>
                                            <TextBlock Text=" · " FontSize="12" Foreground="{StaticResource FgMutedBrush}"/>
                                            <Border Background="{StaticResource BgItemBrush}" CornerRadius="3" Padding="5,1">
                                                <TextBlock Text="{Binding HistoryVM.SelectedEntry.Revision, StringFormat='r{0}'}"
                                                           FontSize="12" FontFamily="Consolas"
                                                           Foreground="{StaticResource AccentBlueBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Changed paths list -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="16,0">
                                    <TextBlock Text="변경된 파일"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource FgMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ListView Grid.Row="1"
                                          ItemsSource="{Binding HistoryVM.SelectedEntry.ChangedPaths}"
                                          Background="Transparent" BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="14,7"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SvnChangedPath}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,9,0"
                                                        Background="{StaticResource BgItemBrush}">
                                                    <TextBlock Text="{Binding Action}"
                                                               FontSize="10" FontWeight="Bold" FontFamily="Consolas"
                                                               Foreground="{StaticResource AccentBlueBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Path}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           Foreground="{StaticResource FgPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
